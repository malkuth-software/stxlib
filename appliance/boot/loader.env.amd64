# The ESP's /efi/freebsd/loader.env on x86-64 (GPT, appliance/disk/LAYOUT.md),
# read by loader.efi (stand/efi/loader/main.c:1289-1302). The partitions
# are those of the VM; the stx.* devices are for local.lua. The loader's
# console is the firmware's (efi): the screen on a board, and the serial
# line under OVMF, which mirrors its console there; efi,comconsole printed
# every character twice on QEMU. The kernel's console is the screen and the
# first serial port both (boot_serial, boot_multicons).
rootdev=disk0p2:
stx.esp_device=disk0p1:
stx.slot_a_device=disk0p3:
stx.slot_b_device=disk0p4:
console=efi
boot_multicons=YES
boot_serial=YES
