# The ESP's /efi/freebsd/loader.env on x86-64 (GPT, appliance/disk/LAYOUT.md),
# read by loader.efi (stand/efi/loader/main.c:1289-1302). The partitions
# are those of the VM; the stx.* devices are for local.lua. The console is
# the screen and the first serial port both: the loader's and the
# kernel's (boot_multicons), so that the QEMU scenario reads the serial
# line and a board shows its boot on the screen.
rootdev=disk0p2:
stx.esp_device=disk0p1:
stx.slot_a_device=disk0p3:
stx.slot_b_device=disk0p4:
console=efi,comconsole
boot_multicons=YES
boot_serial=YES
