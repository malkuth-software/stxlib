# The ESP's /efi/freebsd/loader.env on the Raspberry Pi 4 (MBR), read by
# loader.efi (stand/efi/loader/main.c:1289-1302). The SD card is the first
# disk U-Boot's UEFI offers; slice 2 is BSD-labelled (appliance/disk/LAYOUT.md):
# a = boot control (rootdev, main.c:520-530), d = root A, e = root B.
rootdev=disk0s2a:
stx.esp_device=disk0s1:
stx.slot_a_device=disk0s2d:
stx.slot_b_device=disk0s2e:
