# The ESP's /efi/freebsd/loader.env on the VM (GPT), read by loader.efi
# (stand/efi/loader/main.c:1289-1302). rootdev is the boot-control
# partition (main.c:520-530); the stx.* devices are for local.lua.
rootdev=disk0p2:
stx.esp_device=disk0p1:
stx.slot_a_device=disk0p3:
stx.slot_b_device=disk0p4:
