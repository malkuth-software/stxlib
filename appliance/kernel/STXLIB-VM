#
# STXLIB-VM -- the appliance kernel for the C1 VM (QEMU virt, arm64, HVF).
#
# Method (coordinator, 2026-11-13): FreeBSD's arm64 GENERIC (releng/15.2 at
# fb9033d2876d) minus what the appliance does not need, as nodevice and
# nooptions lines, each with its reason. GENERIC builds; every cut is then
# measured (kernel size and boot time, appliance/vm/README.md). The earlier
# build-up draft (git history to dd95cde) records which std.* entries
# standard files need: HWPMC_HOOKS (sys/arm/arm/pmu.c), KTRACE
# (kern/subr_syscall.c needs sys/uio.h only under KTRACE), clk and the
# other std.dev frameworks (pci_dw_mv.c needs clknode_if.h).
#
# STXLIB-GENERIC is this file's baseline (GENERIC plus TSLOG).
# check_config.py statically checks a cut for missing generated headers.
#
include 	"GENERIC"
ident		STXLIB-VM

options 	TSLOG			# timestamps: sysctl debug.tslog, debug.tslog_user
options 	TSLOGSIZE=262144

# ==========================================================================
# Batch 1 (2026-11-13): device classes absent from QEMU virt, INET6, debug
# message options. WITNESS, INVARIANTS, INVARIANT_SUPPORT and DIAGNOSTIC are
# not in releng GENERIC (no std.debug on a release branch), so nothing to
# cut there. Kept although cuttable later: DDB/KDB, KDTRACE_*, DEBUG=-g
# (bring-up), virtio_mmio (QEMU virt has empty virtio-mmio transports; we
# use PCI), USB host xhci + usb + HID/keyboard (kept for C3: the Pi 4's
# VL805 is xhci on PCIe).
# ==========================================================================

# --- 1a. SoC support: every std.<soc> entry not also in std.arm64, std.dev,
# std.virt or DEFAULTS, so GENERIC reduces to FreeBSD's own VIRT set
# (sys/arm64/conf/VIRT). Generated by sb2 dev/tools/soc_cuts.py, then:
# kept pl031 (QEMU virt has a PL031 RTC at 0x09010000) and uart_ns8250
# (dev/uart/uart_bus_pci.c:295, built with uart+pci, references
# uart_ns8250_class).

