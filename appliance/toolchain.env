# The appliance's one toolchain variable (owner, 2026-11-13, P2 = 1: the
# kernel, loader and shim are built with our LLVM pin throughout).
#
# Every appliance script and build reads the compiler from here and nowhere
# else, so a repin (LLVM 23.x is planned after GUI.Forms 1.0) changes this
# file only. Shell syntax, KEY=value, no spaces; read by appliance/vm/*.py
# and by the kernel build notes in appliance/kernel/README.md.
#
# The M4's paths are as the integrator reported them on 2026-11-13: llvm@22
# from Homebrew; lld is a separate Homebrew formula (lld@22), released for
# download by the coordinator the same day. Both paths are unconfirmed until
# the integrator checks them.

STXLIB_LLVM_VERSION=22.1.8
STXLIB_LLVM_BINDIR=/opt/homebrew/opt/llvm@22/bin
STXLIB_LLD_BINDIR=/opt/homebrew/opt/lld@22/bin
