    case 3U:
        return misuse_start_start_stack(step, holder);
    case 4U:
        return legal_identity(step, holder);
    case 5U:
        return legal_request_stop(step, holder);
    case 6U:
        return legal_join(step, holder);
    case 7U:
        return outside_join_empty(step, holder);
    case 8U:
        return legal_abandon(step, holder);
    case 9U:
        return outside_abandon_empty(step, holder);
    default:
        return ::stxlib_ic::Outcome::skipped;
    }
}

